# Файл Gemfile — список программ, нужных для локального запуска сайта.
# Читается командой `bundle install`.
#
# Зачем это нужно: чтобы у всех, кто открывает проект, была
# одна и та же версия Jekyll. Без этого файл сайт может собраться
# у одного человека, а у другого нет.

# Источник, откуда скачиваются программы
source "https://rubygems.org"

# Jekyll — программа, которая превращает файлы .md в готовый сайт .html
gem "jekyll", "~> 4.4"

# webrick — маленький веб-сервер для команды `jekyll serve`.
# В новых версиях Ruby его убрали из стандартной поставки,
# поэтому подключаем отдельно.
gem "webrick", "~> 1.9"

# На Windows Jekyll требует дополнительные gem-пакеты для корректной работы.
# На macOS они не нужны, поэтому подключаем только для Windows.
platform :windows do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end